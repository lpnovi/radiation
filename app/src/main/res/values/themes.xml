<resources>
    <!--
      System font everywhere. Material 3 draws titles, labels, buttons and chips in "sans-serif-medium",
      a separate family that custom device fonts (e.g. Samsung font styles) may not replace. These use
      the default family instead and express emphasis as weight (values-v28: 500; older: bold).
      Body and headline styles already use the default family.
    -->
    <style name="Theme.Radiation" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Radiation.TitleSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Radiation.TitleMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Radiation.LabelLarge</item>
    </style>

    <style name="TextAppearance.Radiation.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Radiation.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Radiation.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Studio.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <style name="Studio.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Studio.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="Studio.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">true</item>
    </style>

    <style name="Studio.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Studio.ValueRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Studio.ValueLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="Studio.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Studio.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Small segmented control for the preview state, sized to its labels. -->
    <style name="Studio.Segment.Compact" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Studio.Switch" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>
    <!-- Widget bottom visualizer (used inside RemoteViews, so framework attributes only). -->
    <style name="Widget.Visualizer" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/viz_height</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:layout_marginStart">@dimen/viz_inset</item>
        <item name="android:layout_marginEnd">@dimen/viz_inset</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateOnly">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxHeight">@dimen/viz_height</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:visibility">gone</item>
    </style>
    <!-- Widget text (RemoteViews). No font family: the launcher draws it in the system font. -->
    <style name="Widget.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">@string/nothing_playing</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- Medium is weight 500 on Android 9+ (values-v28); bold before. -->
    <style name="Widget.Title.Medium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Title.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ClockTime.Base" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">40sp</item>
    </style>

    <!-- Large clock numerals; values-v28 adds a light weight of the system font. -->
    <style name="Widget.ClockTime" parent="Widget.ClockTime.Base" />

    <style name="Widget.LaunchSlot" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxWidth">72dp</item>
        <item name="android:background">@drawable/ripple_on_dark</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.Artist" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">@string/app_name</item>
        <item name="android:textColor">#B8FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.Artist.Medium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
