<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="TooManyViews">
    <!-- One scrolling settings screen inflated once; ~90 views costs a few ms. -->

    <!-- Header and preview stay pinned so the widget is always visible while editing. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/studio_subtitle"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Card background is set to the wallpaper's color so translucency previews honestly. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/preview_card"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="28dp">

        <!-- Touches stop here: the preview is rendered without PendingIntents and is inert. -->
        <com.lpnovi.radiation.PreviewFrame
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="24dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Studio-only: which state the preview shows. Never touches real playback. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/preview_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/preview_playing"
            style="@style/Studio.Segment.Compact"
            android:text="@string/preview_playing" />

        <Button
            android:id="@+id/preview_idle"
            style="@style/Studio.Segment.Compact"
            android:text="@string/preview_idle" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/access_card"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/access_body"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/access_restricted_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <Button
                        android:id="@+id/access_grant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/access_grant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_widgets"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_widgets"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <Button
                        android:id="@+id/pin_widget"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/pin_widget" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:id="@+id/widget_picker_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/widget_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Player -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:text="@string/section_player" />

                        <!-- Bind to player: a row that opens the player picker. -->
                        <LinearLayout
                            android:id="@+id/bind_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="56dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/bind_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_music_note"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/bind_to_player"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/bind_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/follow_active"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <TextView
                            style="@style/Studio.Hint"
                            android:text="@string/hint_bind" />

                        <TextView
                            style="@style/Studio.Label"
                            android:text="@string/section_tap" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/tap_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/tap_active"
                                style="@style/Studio.Segment"
                                android:text="@string/tap_active" />

                            <Button
                                android:id="@+id/tap_spotify"
                                style="@style/Studio.Segment"
                                android:text="@string/tap_spotify" />

                            <Button
                                android:id="@+id/tap_nothing"
                                style="@style/Studio.Segment"
                                android:text="@string/tap_nothing" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Idle -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:layout_marginBottom="0dp"
                            android:text="@string/section_idle" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/idle_enabled"
                            style="@style/Studio.Switch"
                            android:text="@string/idle_mode" />

                        <TextView
                            android:id="@+id/idle_off_hint"
                            style="@style/Studio.Hint"
                            android:layout_marginTop="0dp"
                            android:text="@string/hint_idle_off" />

                        <!-- Shown only with Idle mode on; settings kept when it's turned off. -->
                        <LinearLayout
                            android:id="@+id/idle_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Studio.Label"
                                android:layout_marginTop="4dp"
                                android:text="@string/idle_content" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/idle_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:chipSpacingVertical="0dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/idle_resume_choice"
                                    style="@style/Studio.Choice"
                                    android:text="@string/idle_resume_chip" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/idle_launch_choice"
                                    style="@style/Studio.Choice"
                                    android:text="@string/idle_launch_chip" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/idle_clock_choice"
                                    style="@style/Studio.Choice"
                                    android:text="@string/idle_clock_chip" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/idle_minimal_choice"
                                    style="@style/Studio.Choice"
                                    android:text="@string/idle_minimal_chip" />
                            </com.google.android.material.chip.ChipGroup>

                            <TextView
                                android:id="@+id/idle_hint"
                                style="@style/Studio.Hint" />

                            <!-- Per-content options: only the selected content's are shown. -->
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/resume_show_track"
                                style="@style/Studio.Switch"
                                android:text="@string/resume_show_track" />

                            <LinearLayout
                                android:id="@+id/shortcut_slots"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/clock_show_date"
                                style="@style/Studio.Switch"
                                android:text="@string/clock_show_date" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/minimal_show_player"
                                style="@style/Studio.Switch"
                                android:text="@string/minimal_show_player" />

                            <TextView
                                style="@style/Studio.Label"
                                android:text="@string/pause_idle" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/pause_idle_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <Button
                                    android:id="@+id/pause_1"
                                    style="@style/Studio.Segment"
                                    android:text="@string/pause_1_min" />

                                <Button
                                    android:id="@+id/pause_5"
                                    style="@style/Studio.Segment"
                                    android:text="@string/pause_5_min" />

                                <Button
                                    android:id="@+id/pause_never"
                                    style="@style/Studio.Segment"
                                    android:text="@string/pause_never" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Background -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:text="@string/section_background" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/bg_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingVertical="0dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_album_tint"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_album_tint" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_album_gradient"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_album_gradient" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_amoled"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_amoled" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_material_you"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_material_you" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_glass"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_glass" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/bg_custom"
                                style="@style/Studio.Choice"
                                android:text="@string/bg_custom" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            android:id="@+id/bg_hint"
                            style="@style/Studio.Hint" />

                        <!-- Filled in code; shown only for the Custom background. -->
                        <HorizontalScrollView
                            android:id="@+id/swatch_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/swatches"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            style="@style/Studio.Label"
                            android:text="@string/album_tone" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/tone_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/tone_rich"
                                style="@style/Studio.Segment"
                                android:text="@string/tone_rich" />

                            <Button
                                android:id="@+id/tone_pastel"
                                style="@style/Studio.Segment"
                                android:text="@string/tone_pastel" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/Studio.Hint"
                            android:text="@string/hint_album_tone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/background_opacity"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/opacity_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/opacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stepSize="1"
                            android:valueFrom="0"
                            android:valueTo="100"
                            app:labelBehavior="gone"
                            app:tickVisible="false" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/outline"
                            style="@style/Studio.Switch"
                            android:text="@string/outline" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Typography -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:layout_marginBottom="0dp"
                            android:text="@string/section_typography" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/preview_sample"
                            style="@style/Studio.Switch"
                            android:text="@string/preview_long_title" />

                        <!-- Title -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_title"
                            style="@style/Studio.Switch"
                            android:text="@string/show_title" />

                        <LinearLayout
                            android:id="@+id/title_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout style="@style/Studio.ValueRow">

                                <TextView
                                    style="@style/Studio.ValueLabel"
                                    android:text="@string/title_size" />

                                <TextView
                                    android:id="@+id/title_size_value"
                                    style="@style/Studio.Value" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/title_size"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stepSize="0.5"
                                android:valueFrom="12"
                                android:valueTo="19"
                                app:labelBehavior="gone"
                                app:tickVisible="false" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/title_weight_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <Button
                                    android:id="@+id/ty_title_regular"
                                    style="@style/Studio.Segment"
                                    android:text="@string/weight_regular" />

                                <Button
                                    android:id="@+id/ty_title_medium"
                                    style="@style/Studio.Segment"
                                    android:text="@string/weight_medium" />

                                <Button
                                    android:id="@+id/ty_title_bold"
                                    style="@style/Studio.Segment"
                                    android:text="@string/weight_bold" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/title_lines_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <Button
                                    android:id="@+id/lines_one"
                                    style="@style/Studio.Segment"
                                    android:text="@string/lines_one" />

                                <Button
                                    android:id="@+id/lines_two"
                                    style="@style/Studio.Segment"
                                    android:text="@string/lines_two" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/fit_title"
                                style="@style/Studio.Switch"
                                android:text="@string/fit_title" />
                        </LinearLayout>

                        <!-- Artist -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_artist"
                            style="@style/Studio.Switch"
                            android:text="@string/show_artist" />

                        <LinearLayout
                            android:id="@+id/artist_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout style="@style/Studio.ValueRow">

                                <TextView
                                    style="@style/Studio.ValueLabel"
                                    android:text="@string/artist_size" />

                                <TextView
                                    android:id="@+id/artist_size_value"
                                    style="@style/Studio.Value" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/artist_size"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stepSize="0.5"
                                android:valueFrom="10"
                                android:valueTo="16"
                                app:labelBehavior="gone"
                                app:tickVisible="false" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/artist_weight_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <Button
                                    android:id="@+id/ty_artist_regular"
                                    style="@style/Studio.Segment"
                                    android:text="@string/weight_regular" />

                                <Button
                                    android:id="@+id/ty_artist_medium"
                                    style="@style/Studio.Segment"
                                    android:text="@string/weight_medium" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>

                        <TextView
                            style="@style/Studio.Hint"
                            android:layout_marginTop="12dp"
                            android:text="@string/hint_typography" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Controls -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:text="@string/section_controls" />

                        <TextView
                            style="@style/Studio.Label"
                            android:layout_marginTop="0dp"
                            android:text="@string/controls_color" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/accent_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/accent_album"
                                style="@style/Studio.Segment"
                                android:text="@string/accent_album" />

                            <Button
                                android:id="@+id/accent_material_you"
                                style="@style/Studio.Segment"
                                android:text="@string/accent_material_you" />

                            <Button
                                android:id="@+id/accent_mono"
                                style="@style/Studio.Segment"
                                android:text="@string/accent_mono" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/Studio.Label"
                            android:text="@string/icon_style" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/icon_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/icons_rounded"
                                style="@style/Studio.Segment"
                                android:text="@string/icons_rounded" />

                            <Button
                                android:id="@+id/icons_sharp"
                                style="@style/Studio.Segment"
                                android:text="@string/icons_sharp" />

                            <Button
                                android:id="@+id/icons_line"
                                style="@style/Studio.Segment"
                                android:text="@string/icons_line" />

                            <Button
                                android:id="@+id/icons_bold"
                                style="@style/Studio.Segment"
                                android:text="@string/icons_bold" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_previous"
                            style="@style/Studio.Switch"
                            android:layout_marginTop="8dp"
                            android:text="@string/show_previous" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_next"
                            style="@style/Studio.Switch"
                            android:text="@string/show_next" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_shuffle"
                            style="@style/Studio.Switch"
                            android:text="@string/show_shuffle" />

                        <TextView
                            style="@style/Studio.Hint"
                            android:layout_marginTop="0dp"
                            android:text="@string/hint_shuffle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Visualizer -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:text="@string/section_visualizer" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/viz_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/choice_viz_off"
                                style="@style/Studio.Segment"
                                android:text="@string/viz_off" />

                            <Button
                                android:id="@+id/choice_viz_bars"
                                style="@style/Studio.Segment"
                                android:text="@string/viz_bars" />

                            <Button
                                android:id="@+id/choice_viz_wave"
                                style="@style/Studio.Segment"
                                android:text="@string/viz_wave" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/Studio.Hint"
                            android:text="@string/hint_visualizer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Layout -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Studio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            style="@style/Studio.Section"
                            android:text="@string/section_layout" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/show_art"
                            style="@style/Studio.Switch"
                            android:text="@string/show_art" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/art_shape_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/art_rounded"
                                style="@style/Studio.Segment"
                                android:text="@string/art_rounded" />

                            <Button
                                android:id="@+id/art_circle"
                                style="@style/Studio.Segment"
                                android:text="@string/art_circle" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/done"
        android:visibility="gone" />
</LinearLayout>
