<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews layout: framework views only. Hosts may *reapply* updates onto the existing view tree,
  so WidgetRenderer sets every dynamic property on every render; nothing relies on XML defaults
  after the first update.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <!-- The only layer that background opacity touches. -->
    <ImageView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="@dimen/art_size"
            android:layout_height="@dimen/art_size"
            android:contentDescription="@string/album_art">

            <ImageView
                android:id="@+id/placeholder_tile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/rounded_square"
                android:tint="#1FFFFFFF" />

            <ImageView
                android:id="@+id/placeholder_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note"
                android:tint="#99FFFFFF" />

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#B8FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/previous"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/previous"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous_state"
            android:tint="#FFFFFFFF" />

        <!-- Focal point: a filled disc in the accent color, glyph cut out in onAccent. -->
        <FrameLayout
            android:id="@+id/play_pause"
            android:layout_width="@dimen/play_size"
            android:layout_height="@dimen/play_size"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@string/play_pause">

            <ImageView
                android:id="@+id/play_pause_disc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/disc_state"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_state"
                android:tint="#FF000000" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/next"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/next"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next_state"
            android:tint="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
