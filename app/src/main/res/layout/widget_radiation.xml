<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews layout: framework views only. Hosts may *reapply* updates onto the existing view tree,
  so WidgetRenderer sets every dynamic property on every render; nothing relies on XML defaults
  after the first update.

  Layers, back to front: surface or glow -> border -> visualizer strip -> content row -> corner shuffle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <!-- Background layers: the only views that background opacity touches. -->
    <ImageView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000" />

    <!--
      Album Glow: one dithered bitmap that replaces the surface (not layered on it, so the rounded
      edge is antialiased once), clipped to the widget's rounded outline.
    -->
    <FrameLayout
        android:id="@+id/glow_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/surface_clip"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </FrameLayout>

    <ImageView
        android:id="@+id/surface_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/border_light"
        android:visibility="gone" />

    <!--
      Bottom visualizer: animated ProgressBar, plus a still frame for reduced motion / Android < 12.
      Inset from the corners and faded at both ends so it reads as part of the surface.
    -->
    <ProgressBar
        android:id="@+id/viz_bars"
        style="@style/Widget.Visualizer"
        android:indeterminateDrawable="@drawable/viz_bars" />

    <ImageView
        android:id="@+id/viz_static"
        android:layout_width="match_parent"
        android:layout_height="@dimen/viz_height"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/viz_inset"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/viz_bars_0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="@dimen/art_size"
            android:layout_height="@dimen/art_size"
            android:contentDescription="@string/album_art">

            <ImageView
                android:id="@+id/placeholder_tile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/rounded_square"
                android:tint="#1FFFFFFF" />

            <ImageView
                android:id="@+id/placeholder_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note"
                android:tint="#99FFFFFF" />

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#B8FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/previous"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/previous"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous_state"
            android:tint="#FFFFFFFF" />

        <!-- Focal point by size alone: a larger bare glyph, no resting background. -->
        <ImageButton
            android:id="@+id/play_pause"
            android:layout_width="@dimen/play_size"
            android:layout_height="@dimen/play_size"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/play_pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_state"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/next"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next_state"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <!--
      Optional shuffle: a small secondary control tucked into the top-right corner, above the
      controls, so it never takes width from the title. Sized at runtime to the space above "next".
    -->
    <ImageButton
        android:id="@+id/shuffle"
        android:layout_width="@dimen/corner_touch_width"
        android:layout_height="@dimen/corner_touch_height"
        android:layout_gravity="top|end"
        android:layout_marginEnd="6dp"
        android:background="@drawable/ripple_on_dark"
        android:contentDescription="@string/shuffle"
        android:paddingHorizontal="13dp"
        android:paddingVertical="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shuffle_off_state"
        android:tint="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
