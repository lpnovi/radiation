<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews layout: framework views only. Hosts may *reapply* updates onto the existing view tree,
  so WidgetRenderer sets every dynamic property on every render; nothing relies on XML defaults
  after the first update.

  Layers, back to front: surface or glow -> border -> visualizer strip -> content row -> corner shuffle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <!-- Background layers: the only views that background opacity touches. -->
    <ImageView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000" />

    <!--
      Album Glow: one dithered bitmap that replaces the surface (not layered on it, so the rounded
      edge is antialiased once), clipped to the widget's rounded outline.
    -->
    <FrameLayout
        android:id="@+id/glow_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/surface_clip"
        android:clipToOutline="true"
        tools:targetApi="31"
        android:visibility="gone">

        <ImageView
            android:id="@+id/glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </FrameLayout>

    <ImageView
        android:id="@+id/surface_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/border_light"
        android:visibility="gone" />

    <!--
      Bottom visualizer: one animated ProgressBar per style (RemoteViews can't swap an indeterminate
      drawable), plus a still frame for reduced motion / Android < 12.
      Inset from the corners and faded at both ends so it reads as part of the surface.
    -->
    <ProgressBar
        android:id="@+id/viz_bars"
        style="@style/Widget.Visualizer"
        android:indeterminateDrawable="@drawable/viz_bars" />

    <ProgressBar
        android:id="@+id/viz_wave"
        style="@style/Widget.Visualizer"
        android:indeterminateDrawable="@drawable/viz_wave" />

    <ImageView
        android:id="@+id/viz_static"
        android:layout_width="match_parent"
        android:layout_height="@dimen/viz_height"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/viz_inset"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/viz_bars_0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="@dimen/art_size"
            android:layout_height="@dimen/art_size"
            android:contentDescription="@string/album_art">

            <ImageView
                android:id="@+id/placeholder_tile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/rounded_square"
                android:tint="#1FFFFFFF" />

            <ImageView
                android:id="@+id/placeholder_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note"
                android:tint="#99FFFFFF" />

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <!--
          Metadata. One title view per weight (RemoteViews can't change a typeface at runtime); the
          renderer shows one and sets size and line count. No font family anywhere: the system font.
        -->
        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title_regular"
                style="@style/Widget.Title"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                style="@style/Widget.Title.Medium" />

            <TextView
                android:id="@+id/title_bold"
                style="@style/Widget.Title.Bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/artist"
                style="@style/Widget.Artist" />

            <TextView
                android:id="@+id/artist_medium"
                style="@style/Widget.Artist.Medium"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/previous"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/previous"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous_state"
            android:tint="#FFFFFFFF" />

        <!-- Focal point by size alone: a larger bare glyph, no resting background. -->
        <ImageButton
            android:id="@+id/play_pause"
            android:layout_width="@dimen/play_size"
            android:layout_height="@dimen/play_size"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/play_pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_state"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="@dimen/side_touch"
            android:layout_height="@dimen/side_touch"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/next"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next_state"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <!--
      Idle content (Idle mode on, nothing playing). Shares the surface, colors and corners above; only
      the media row is swapped out. Resume reuses the media row itself.
    -->

    <!-- Clock: TextClock ticks inside the launcher, so no updates are needed from Radiation. -->
    <LinearLayout
        android:id="@+id/idle_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <TextClock
            android:id="@+id/clock_time"
            style="@style/Widget.ClockTime" />

        <LinearLayout
            android:id="@+id/clock_date_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock_weekday"
                style="@style/Widget.Title.Medium"
                android:layout_width="wrap_content"
                android:textSize="13sp" />

            <TextClock
                android:id="@+id/clock_date"
                style="@style/Widget.Artist"
                android:layout_width="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Launch: up to four app icons, evenly spaced. -->
    <LinearLayout
        android:id="@+id/idle_launch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/launch_0"
            style="@style/Widget.LaunchSlot"
            android:contentDescription="@string/idle_launch_chip" />

        <ImageButton
            android:id="@+id/launch_1"
            style="@style/Widget.LaunchSlot"
            android:contentDescription="@string/idle_launch_chip" />

        <ImageButton
            android:id="@+id/launch_2"
            style="@style/Widget.LaunchSlot"
            android:contentDescription="@string/idle_launch_chip" />

        <ImageButton
            android:id="@+id/launch_3"
            style="@style/Widget.LaunchSlot"
            android:contentDescription="@string/idle_launch_chip" />

        <TextView
            android:id="@+id/launch_hint"
            style="@style/Widget.Artist"
            android:layout_width="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/launch_hint"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Minimal: a single resume glyph, optionally naming the player. -->
    <LinearLayout
        android:id="@+id/idle_minimal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/min_play"
            android:layout_width="@dimen/play_size"
            android:layout_height="@dimen/play_size"
            android:background="@drawable/ripple_on_dark"
            android:contentDescription="@string/idle_resume"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_state"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/min_label"
            style="@style/Widget.Artist"
            android:layout_width="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:textSize="15sp" />
    </LinearLayout>

    <!--
      Optional shuffle: a secondary control in the top-right corner, in the column of the rightmost
      transport control, so it never takes width from the title. Its target fills the free space above
      that control (sized at runtime on Android 12+); the glyph stays small.
    -->
    <ImageButton
        android:id="@+id/shuffle"
        android:layout_width="@dimen/corner_touch_width"
        android:layout_height="@dimen/corner_touch_height"
        android:layout_gravity="top|end"
        android:layout_marginEnd="4dp"
        android:background="@drawable/ripple_on_dark"
        android:contentDescription="@string/shuffle"
        android:paddingHorizontal="18dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shuffle_off_state"
        android:tint="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
