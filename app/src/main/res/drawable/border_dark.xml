<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline border, dark. Pre-colored on purpose: tinting a stroke-only shape with a color filter
     also paints its interior, which washed the whole surface. Only opacity is set at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="0.6dp" android:color="#FF000000" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
