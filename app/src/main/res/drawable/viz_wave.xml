    <item android:drawable="@drawable/viz_wave_8" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_9" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_10" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_11" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_12" android:duration="80" />
