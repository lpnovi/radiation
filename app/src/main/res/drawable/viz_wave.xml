    <item android:drawable="@drawable/viz_wave_2" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_3" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_4" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_5" android:duration="80" />
    <item android:drawable="@drawable/viz_wave_6" android:duration="80" />
